<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VirtualPathCore.ViewModels"
             xmlns:opengl="using:VirtualPathCore.Graphics.OpenGL"
             mc:Ignorable="d"
             x:Class="VirtualPathCore.Views.MainView"
             x:DataType="vm:MainViewModel"
             xmlns:views="using:VirtualPathCore.Views">

    <Border Margin="6" Background="#222" CornerRadius="8" Padding="0">
        <Grid>
            <opengl:Renderer x:Name="glRenderer1" />

            <!-- Viewport labels -->
            <TextBlock Text="Perspective" Foreground="#AAA" FontSize="11"
                       VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,6"
                       FontWeight="Bold"/>
            <TextBlock Text="Top" Foreground="#AAA" FontSize="11"
                       VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8,6"
                       FontWeight="Bold"/>
            <TextBlock Text="Front" Foreground="#AAA" FontSize="11"
                       VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,6"
                       FontWeight="Bold"/>
            <TextBlock Text="Right" Foreground="#AAA" FontSize="11"
                       VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8,6"
                       FontWeight="Bold"/>

            <!-- Viewport dividers -->
            <Rectangle VerticalAlignment="Center" Height="2" HorizontalAlignment="Stretch"
                       Fill="#444" IsHitTestVisible="False" Margin="0"/>
            <Rectangle HorizontalAlignment="Center" Width="2" VerticalAlignment="Stretch"
                       Fill="#444" IsHitTestVisible="False" Margin="0"/>

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8,4" Spacing="2" Opacity="0.6">
                <TextBlock Foreground="White" FontWeight="Bold" FontSize="12" Text="3D Viewport" HorizontalAlignment="Center"/>
                <TextBlock Foreground="#AAA" FontSize="10" Text="Left-drag: Orbit | Scroll: Zoom | F: Frame" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
