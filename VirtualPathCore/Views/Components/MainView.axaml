<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VirtualPathCore.ViewModels"
             xmlns:opengl="using:VirtualPathCore.Graphics.OpenGL"
             mc:Ignorable="d"
             x:Class="VirtualPathCore.Views.MainView"
             x:DataType="vm:MainViewModel"
             xmlns:views="using:VirtualPathCore.Views">

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*">
        <Border Grid.Row="0" Margin="6" Background="#222" CornerRadius="8" Padding="6">
            <Grid>
                <opengl:Renderer x:Name="glRenderer1" />
                <StackPanel VerticalAlignment="Top" Margin="8" Spacing="4" Opacity="0.8">
                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="14" Text="3D Viewport" />
                    <TextBlock Foreground="#AAA" FontSize="11" Text="Left-drag: Orbit | Scroll: Zoom" />
                </StackPanel>
            </Grid>
        </Border>

        <views:ParameterControlPanel Grid.Row="1" />
    </Grid>
</UserControl>
