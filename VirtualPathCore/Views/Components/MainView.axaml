<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VirtualPathCore.ViewModels"
             xmlns:opengl="using:VirtualPathCore.Graphics.OpenGL"
             mc:Ignorable="d"
             x:Class="VirtualPathCore.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid>
        <opengl:Renderer x:Name="glRenderer1" />

        <!-- Perspective label (TL) -->
        <Border Background="#00000060" CornerRadius="6" Padding="8,3"
                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,6">
            <TextBlock Text="Perspective" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Medium"/>
        </Border>

        <!-- Quad viewport overlay grid -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top label + close (TR) -->
            <Border Grid.Row="0" Grid.Column="1" IsVisible="{Binding ShowTopView}"
                    Background="#00000060" CornerRadius="6" Padding="8,3"
                    VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Top" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Medium"/>
                    <Button Content="×" FontSize="11" Padding="2,0" MinWidth="16" MinHeight="16"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Command="{Binding ToggleTopViewCommand}"/>
                </StackPanel>
            </Border>

            <!-- Front label + close (BL) -->
            <Border Grid.Row="1" Grid.Column="0" IsVisible="{Binding ShowFrontView}"
                    Background="#00000060" CornerRadius="6" Padding="8,3"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Front" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Medium"/>
                    <Button Content="×" FontSize="11" Padding="2,0" MinWidth="16" MinHeight="16"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Command="{Binding ToggleFrontViewCommand}"/>
                </StackPanel>
            </Border>

            <!-- Right label + close (BR) -->
            <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding ShowRightView}"
                    Background="#00000060" CornerRadius="6" Padding="8,3"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Medium"/>
                    <Button Content="×" FontSize="11" Padding="2,0" MinWidth="16" MinHeight="16"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Command="{Binding ToggleRightViewCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Info -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8" Spacing="2" Opacity="0.3">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="Orbit: Left-drag · Zoom: Scroll · Frame: F" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
