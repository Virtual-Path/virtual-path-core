<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="260"
        x:Class="VirtualPathCore.Views.Components.SettingsWindow"
        Title="Settings"
        Width="380" Height="260"
        Background="{StaticResource SidebarBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Border Margin="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel Margin="24,20" Spacing="14">
            <TextBlock Text="Language" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox x:Name="LanguageComboBox" SelectionChanged="LanguageChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                <ComboBoxItem Content="English" Tag="en-US"/>
            </ComboBox>

            <TextBlock Text="Theme" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Follow System"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>

            <Button Content="Close" Click="CloseWindow" HorizontalAlignment="Right" MinWidth="90" Height="30" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
