<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:VirtualPathCore.ViewModels"
        x:Class="VirtualPathCore.Views.CreateProjectWindow"
        x:DataType="viewModels:CreateProjectViewModel"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource SidebarBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        Topmost="False"
        Icon="/Assets/Const.png"
        Title="New Project">
    <Window.DataContext>
        <viewModels:CreateProjectViewModel />
    </Window.DataContext>
    <Border Margin="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13"/>
            <TextBox Text="{Binding ProjectName}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center"/>

            <TextBlock Text="Description" Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" FontSize="13"/>
            <TextBox Text="{Binding ProjectDescription}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" TextWrapping="Wrap" Height="60" VerticalAlignment="Top"/>

            <TextBlock Text="Path" Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13"/>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ProjectPath}" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Content="Browse" Grid.Column="1" Width="90" VerticalAlignment="Center" Command="{Binding SelectProjectPathCommand}"/>
            </Grid>

            <Button Content="Create" Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="100" Margin="0,8,0,0" Command="{Binding CreateProjectCommand}" FontWeight="SemiBold"/>
        </Grid>
    </Border>
</Window>
