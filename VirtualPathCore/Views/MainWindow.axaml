<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VirtualPathCore.ViewModels"
        xmlns:views="clr-namespace:VirtualPathCore.Views"
        xmlns:components="clr-namespace:VirtualPathCore.Views.Components"
        xmlns:helpers="clr-namespace:VirtualPathCore.Helpers"
        x:Class="VirtualPathCore.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Logo.png"
        Title="Virtual Path 3D Engine"
        WindowState="Maximized">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <components:AppMenu Grid.ColumnSpan="3" Grid.Row="0"
                            ToggleSidebarClicked="ToggleSidebar"
                            ToggleDockClicked="ToggleDock"/>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Background="#2A2A2A" Orientation="Horizontal" Margin="6,4">
            <Button Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Height="26" Margin="0,0,2,0"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Height="26" Margin="0,0,6,0"/>
            <Button Content="T" Command="{Binding SetGizmoTranslateCommand}" Height="26" Width="30" Margin="0,0,2,0"/>
            <Button Content="R" Command="{Binding SetGizmoRotateCommand}" Height="26" Width="30" Margin="0,0,2,0"/>
            <Button Content="S" Command="{Binding SetGizmoScaleCommand}" Height="26" Width="30" Margin="0,0,6,0"/>
            <Button Content="Frame" Command="{Binding FrameSelectedCommand}" Height="26" Margin="0,0,2,0"/>
            <Button Content="Reset Cam" Command="{Binding ResetCameraCommand}" Height="26" Margin="0,0,6,0"/>
            <Button Content="+ Cube" Command="{Binding AddCubeCommand}" Height="26" Margin="0,0,2,0"/>
            <Button Content="+ Sphere" Command="{Binding AddSphereCommand}" Height="26" Margin="0,0,2,0"/>
            <Button Content="+ Dir Light" Command="{Binding AddDirectionalLightCommand}" Height="26" Margin="0,0,2,0"/>
            <Button Content="+ Point Light" Command="{Binding AddPointLightCommand}" Height="26"/>
        </StackPanel>

        <!-- Scene Tree -->
        <Border x:Name="SidebarBorder" Background="#252525" Grid.Row="2" Grid.Column="0" CornerRadius="4" Margin="4">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="8,6">
                    <TextBlock Grid.Column="0" Text="Scene Objects" Foreground="White" FontWeight="Bold"/>
                    <Button Grid.Column="1" Content="+" Width="22" Height="22" Padding="0" Command="{Binding ExpandAllCommand}"/>
                    <Button Grid.Column="2" Content="-" Width="22" Height="22" Padding="0" Command="{Binding CollapseAllCommand}" Margin="4,0,0,0"/>
                </Grid>

                <TextBox Grid.Row="1" Text="{Binding SearchFilter}" Watermark="Search..." Margin="8,0,8,4"
                         Background="#333" Foreground="White" BorderThickness="0" Padding="6,4"/>

                <ListBox Grid.Row="2" x:Name="SceneObjectList"
                         ItemsSource="{Binding SceneObjects}"
                         SelectedItem="{Binding SelectedObject}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#3D6B4B"/>
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#333"/>
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneObjectViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                                <TextBlock Grid.Column="0" Text="&#x2600;" Foreground="#FFD700" Margin="0,0,6,0"
                                           IsVisible="{Binding IsLight}"/>
                                <TextBlock Grid.Column="0" Text="&#x25A0;" Foreground="#4CAF50" Margin="0,0,6,0"
                                           IsVisible="{Binding IsLight, Converter={x:Static helpers:BoolConverters.Not}}"/>
                                <TextBox Grid.Column="1" Text="{Binding Name}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" MinWidth="60"
                                         Padding="2,0" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible}" Foreground="#888"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8" Spacing="4">
                    <Button Content="Duplicate" Command="{Binding DuplicateSelectedCommand}" Height="26" Width="80"/>
                    <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" Height="26" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3D Viewport -->
        <Border x:Name="ContentBorder" Background="#1A1A1A" Grid.Row="2" Grid.Column="1" CornerRadius="4" Margin="4">
            <views:MainView />
        </Border>

        <!-- Properties Panel -->
        <Border x:Name="AIChatBorder" Background="#252525" Grid.Row="2" Grid.Column="2" CornerRadius="4" Margin="4">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Properties" Foreground="White" FontWeight="Bold" Margin="8,6"/>

                <StackPanel Grid.Row="1" Margin="8" Spacing="4">
                    <TextBlock Text="Add Object" Foreground="#AAA" FontSize="12"/>
                    <WrapPanel>
                        <Button Content="+ Cube" Command="{Binding AddCubeCommand}" Width="72" Height="26" Margin="0,0,4,0"/>
                        <Button Content="+ Sphere" Command="{Binding AddSphereCommand}" Width="80" Height="26" Margin="0,0,4,0"/>
                        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" Width="60" Height="26"/>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="2" Margin="8">
                    <Grid>
                        <StackPanel Spacing="10" IsVisible="{Binding HasSelectedObject}">
                            <!-- Transform -->
                            <StackPanel DataContext="{Binding SelectedObject}" Spacing="6">
                                <TextBlock Text="Transform" Foreground="#AAA" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-10" Maximum="10" Value="{Binding PositionX}" Margin="0,0,8,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                    <Slider Grid.Row="0" Grid.Column="3" Minimum="-10" Maximum="10" Value="{Binding PositionY}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Z" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-10" Maximum="10" Value="{Binding PositionZ}" Margin="0,0,8,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="S" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                    <Slider Grid.Row="1" Grid.Column="3" Minimum="0.1" Maximum="5" Value="{Binding ScaleX}" Margin="0,0,0,2"/>
                                </Grid>

                                <!-- Grid toggle -->
                                <CheckBox IsChecked="{Binding $parent[Window].DataContext.ShowGrid}" Content="Show Grid" Foreground="#AAA" Margin="0,4,0,0"/>

                                <Separator Background="#3A3A3A" Height="1" Margin="0,2"/>

                                <!-- Material -->
                                <TextBlock Text="Material" Foreground="#AAA" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Metallic" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Minimum="0" Maximum="1" Value="{Binding Metallic}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Roughness" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Minimum="0" Maximum="1" Value="{Binding Roughness}" Margin="0,0,0,2"/>
                                </Grid>

                                <TextBlock Text="Albedo" Foreground="#AAA" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="#E57373" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Minimum="0" Maximum="1" Value="{Binding AlbedoR}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="#81C784" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Minimum="0" Maximum="1" Value="{Binding AlbedoG}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="#64B5F6" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Minimum="0" Maximum="1" Value="{Binding AlbedoB}" Margin="0,0,0,2"/>
                                </Grid>
                            </StackPanel>

                            <!-- Light controls when a light is selected -->
                            <StackPanel Spacing="6" IsVisible="{Binding HasSelectedObject}">
                                <Separator Background="#3A3A3A" Height="1" Margin="0,2"/>
                                <TextBlock Text="Light" Foreground="#AAA" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Intensity" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Minimum="0" Maximum="10" Value="{Binding $parent[Window].DataContext.LightIntensity}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="R" Foreground="#E57373" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding $parent[Window].DataContext.LightR}" Margin="0,0,8,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="G" Foreground="#81C784" VerticalAlignment="Center" Margin="0,0,4,2"/>
                                    <Slider Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding $parent[Window].DataContext.LightG}" Margin="0,0,0,2"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasNoSelectedObject}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="No object selected" Foreground="#555" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Button Grid.Row="3" Content="Clear Scene" Command="{Binding ClearSceneCommand}"
                        Margin="8" Height="26"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#1A1A1A" Padding="8,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#666" FontSize="11"/>
                <TextBlock Grid.Column="2" Foreground="#666" FontSize="11">
                    <Run Text="MSAA: "/><Run Text="{Binding MsaaSamples}"/><Run Text="x"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
