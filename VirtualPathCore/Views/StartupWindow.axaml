<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtualPathCore.StartupWindow"
        Title="Virtual Path"
        Width="440" Height="400"
        Background="{StaticResource WindowBgBrush}"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" Margin="40,0">
            <!-- Logo -->
            <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" Padding="16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    BoxShadow="0 6 24 0 #00000040">
                <Image x:Name="LogoImage"
                       Source="avares://VirtualPathCore/Assets/Logo.png"
                       Width="200" Height="130"
                       RenderTransformOrigin="0.5,0.5"/>
            </Border>

            <!-- Title -->
            <TextBlock x:Name="WelcomeText"
                       Text="Virtual Path 3D Engine"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <!-- Status -->
            <TextBlock x:Name="StatusText"
                       Text="Initializing..."
                       FontSize="13"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" />

            <!-- Progress -->
            <Border CornerRadius="5" Background="{StaticResource InputBgBrush}" Padding="1,0" Width="280"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ProgressBar x:Name="ProgressBar"
                             Minimum="0" Maximum="1"
                             Value="0"
                             Height="5"
                             BorderThickness="0"/>
            </Border>
        </StackPanel>

        <TextBlock Text="Version 0.1.0"
                   FontSize="12"
                   Foreground="{StaticResource TextDisabledBrush}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,20,16" />
    </Grid>
</Window>
